# ───────────────────────────────
# 📦 SeaWhale Project .gitignore
# Node.js / Replit / Fly.io setup
# ───────────────────────────────

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage and testing
lib-cov
coverage
*.lcov
.nyc_output

# Build and dependency directories
node_modules/
jspm_packages/
bower_components
web_modules/

# Build outputs
dist
build
.out
.next
.nuxt
.temp
.cache
.parcel-cache
.vuepress/dist
.docusaurus

# Package manager cache
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# TypeScript build info
*.tsbuildinfo

# Tooling cache
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# REPL / IDE stuff
.node_repl_history
.breakpoints
.vscode-test

# Environment variables (Sensitive)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Serverless / build tools
.serverless/
.fusebox/
.dynamodb/
.tern-port

# Optional backup or deployment files
deploy_to_fly.sh
fly.toml.bak
.env.backup
.env.example

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Lock files
package-lock.json
yarn.lock

# Icons / assets cache
generated-icon.png

# ───────────────────────────────
# ✅ End of SeaWhale .gitignore
# ───────────────────────────────
